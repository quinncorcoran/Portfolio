<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portfolio | Soft Club</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=Inter:wght@300;400;600&display=swap" rel="stylesheet">
    <style>
        :root { --bg: #030712; --accent: #22d3ee; }
        body { background-color: var(--bg); color: white; font-family: 'Inter', sans-serif; overflow-x: hidden; }
        h1, h2 { font-family: 'Syne', sans-serif; }

        /* THE GRAIN/NOISE OVERLAY */
        .noise {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: url('https://grainy-gradients.vercel.app/noise.svg');
            opacity: 0.05; pointer-events: none; z-index: 50;
        }

        /* INTERACTIVE BLOB */
        #blob {
            position: fixed; width: 600px; height: 600px;
            background: radial-gradient(circle, rgba(34, 211, 238, 0.15) 0%, rgba(0,0,0,0) 70%);
            border-radius: 50%; z-index: -1; filter: blur(100px);
            transition: transform 0.15s ease-out; pointer-events: none;
        }

        /* GLASSMORPHISM */
        .glass {
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 24px;
        }

        .stat-card:hover { border-color: var(--accent); transform: translateY(-5px); transition: all 0.3s ease; }
    </style>
</head>
<body>
    <div class="noise"></div>
    <div id="blob"></div>

    <main class="max-w-6xl mx-auto px-6 py-12 md:py-24">
        <!-- HERO GRID -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
            
            <!-- Intro Text -->
            <div class="lg:col-span-7 flex flex-col justify-center">
                <span class="text-cyan-400 font-mono text-sm tracking-widest uppercase mb-4">Portfolio 2024</span>
                <h1 class="text-6xl md:text-8xl font-extrabold tracking-tighter mb-6 leading-tight">
                    EVERYDAY <br> <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-blue-500">VIRAL.</span>
                </h1>
                <p class="text-gray-400 text-lg md:text-xl max-w-md mb-8 leading-relaxed">
                    Social Media Manager & Videographer capturing the digital zeitgeist.
                </p>
                <div class="flex gap-4">
                    <a href="#work" class="px-8 py-4 bg-white text-black font-bold rounded-full hover:bg-cyan-400 transition">View My Hits</a>
                </div>
            </div>

            <!-- THE INSTAGRAM HERO EMBED -->
            <div class="lg:col-span-5">
                <div class="glass p-3 aspect-[9/16] relative group">
                    <div class="absolute inset-0 bg-cyan-500/10 blur-2xl group-hover:bg-cyan-500/20 transition"></div>
                    <!-- REPLACEMENT: Paste your Instagram Embed Code <blockquote> here -->
                    <div class="w-full h-full bg-gray-900 rounded-xl flex items-center justify-center relative z-10 overflow-hidden">
                        <p class="text-gray-600 text-sm">Paste Instagram Embed Here</p>
                    </div>
                </div>
            </div>

        </div>

        <!-- BENTO STATS GRID -->
        <section class="mt-24 grid grid-cols-2 md:grid-cols-4 gap-4">
            <div class="glass p-8 stat-card">
                <h3 class="text-4xl font-bold mb-1">50M+</h3>
                <p class="text-gray-500 text-xs uppercase tracking-widest font-semibold">Total Views</p>
            </div>
            <div class="glass p-8 stat-card">
                <h3 class="text-4xl font-bold mb-1">800K</h3>
                <p class="text-gray-500 text-xs uppercase tracking-widest font-semibold">Engagements</p>
            </div>
            <div class="glass p-8 stat-card">
                <h3 class="text-4xl font-bold mb-1">12</h3>
                <p class="text-gray-500 text-xs uppercase tracking-widest font-semibold">Viral Campaigns</p>
            </div>
            <div class="glass p-8 stat-card">
                <h3 class="text-4xl font-bold mb-1">100%</h3>
                <p class="text-gray-500 text-xs uppercase tracking-widest font-semibold">Organic Growth</p>
            </div>
        </section>
    </main>

    <script>
        const blob = document.getElementById('blob');
        document.addEventListener('mousemove', (e) => {
            const x = e.clientX - 300;
            const y = e.clientY - 300;
            blob.style.transform = `translate(${x}px, ${y}px)`;
        });
    </script>
    <!-- IMPORTANT: Instagram Embed Script -->
    <script async src="//www.instagram.com/embed.js"></script>
</body>
</html>
